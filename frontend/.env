# Public Supabase config only. These are safe to expose in the client bundle
# (RLS + column privileges + SECURITY DEFINER RPCs are what actually protect
# the data — see supabase/migrations/0015_column_privileges.sql and
# 0016_rls_policies.sql). Never put a service_role key or any other secret in
# this file or anywhere under src/ (spec section 49: "Nunca colocar secretos
# en frontend.").
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
